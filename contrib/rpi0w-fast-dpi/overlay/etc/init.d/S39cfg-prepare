#!/bin/sh
# Render all boot templates once, using the small helper when installed.
case "$1" in
    start)
        if [ -x /usr/bin/aa-proxy-config ]; then
            exec /usr/bin/aa-proxy-config --generate-boot-config
        fi
        exec /usr/bin/aa-proxy-rs --generate-boot-config
        ;;
    *)
        echo "Usage: $0 {start}"
        exit 1
        ;;
esac
