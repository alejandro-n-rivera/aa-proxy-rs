#!/bin/sh
# /run is recreated at boot; validate config, template and generated output.
stamp=/var/run/aa-proxy-hostapd.sha256
if [ -f "$stamp" ] && sha256sum -c "$stamp" >/dev/null 2>&1; then
    exit 0
fi
if [ -x /usr/bin/aa-proxy-config ]; then
    exec /usr/bin/aa-proxy-config --generate-hostapd
fi
exec /usr/bin/aa-proxy-rs --generate-hostapd
